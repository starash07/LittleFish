<Window x:Class="LittleFish.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LittleFish 安装"
        Width="820"
        Height="476"
        MinWidth="820"
        MinHeight="476"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="32" ShadowDepth="0" Opacity="0.18" Color="#5B7DA3" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F9FAFB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EAECF0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4E7EC" />
                                <Setter Property="Foreground" Value="#A6B0BF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#1F7AEE" />
            <Setter Property="BorderBrush" Value="#1F7AEE" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1668D9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1668D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1458B8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1458B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4E7EC" />
                                <Setter Property="Foreground" Value="#A6B0BF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#F9FAFB" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#84CAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="5" Background="#EAF6FF" />
                            <Border x:Name="PART_Track" CornerRadius="5" Background="#EAF6FF" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5"
                                    Background="#74C8FF" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="OuterFrame"
                Margin="28"
                CornerRadius="28"
                Background="#F4FBFF"
                BorderBrush="#CFEAFF"
                BorderThickness="1"
                Effect="{StaticResource WindowShadow}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleRow" Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="FooterRow" Height="74" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" CornerRadius="28,28,0,0" Background="#F9FDFF" BorderBrush="#E3F2FF" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/app.png" Width="30" Height="30" />
                            <TextBlock x:Name="WindowTitleText"
                                       Text="LittleFish 安装向导"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1D2939"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowButton}" Content="-" Click="Minimize_Click" />
                            <Button Style="{StaticResource WindowButton}" Content="×" Margin="8,0,0,0" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StepColumn" Width="154" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StepRail" CornerRadius="24" Background="#F8FCFF" BorderBrush="#D7EEFF" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="StepHeader"
                                       Text="安装流程"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#344054"
                                       Margin="0,2,0,22" />
                            <StackPanel>
                                <TextBlock x:Name="StepWelcome"
                                           Text="1  欢迎"
                                           FontSize="14"
                                           Foreground="#1570EF"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16" />
                                <TextBlock x:Name="StepOptions"
                                           Text="2  安装位置"
                                           FontSize="14"
                                           Foreground="#98A2B3"
                                           Margin="0,0,0,16" />
                                <TextBlock x:Name="StepInstall"
                                           Text="3  安装"
                                           FontSize="14"
                                           Foreground="#98A2B3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="BodyPanel" Grid.Column="1" Margin="26,0,0,0">
                        <Grid x:Name="WelcomePage">
                            <StackPanel>
                                <TextBlock x:Name="WelcomeTitle"
                                           Text="欢迎安装 LittleFish"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#101828"
                                           Margin="0,0,0,6" />
                                <TextBlock x:Name="WelcomeSubtitle"
                                           Text="一个能给上班带来乐趣的小工具"
                                           FontSize="14"
                                           Foreground="#667085"
                                           Margin="0,0,0,16" />
                                <Image x:Name="WelcomeHeroCard"
                                       Source="Assets/sponsor.png"
                                       Height="180"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left" />
                                <Border x:Name="UninstallSummaryCard"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0"
                                        Padding="18"
                                        CornerRadius="20"
                                        Background="#F8FCFF"
                                        BorderBrush="#D7EEFF"
                                        BorderThickness="1">
                                    <TextBlock x:Name="UninstallPathText"
                                               TextWrapping="Wrap"
                                               Foreground="#344054"
                                               FontSize="14" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="OptionsPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="选择安装位置"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#101828"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="安装目录" FontWeight="SemiBold" Foreground="#344054" Margin="0,16,0,8" />
                                <DockPanel>
                                    <Button x:Name="BrowseButton"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource FlatButton}"
                                            Content="浏览"
                                            Width="78"
                                            Margin="10,0,0,0"
                                            Click="Browse_Click" />
                                    <TextBox x:Name="InstallPathBox" />
                                </DockPanel>

                                <Border Margin="0,18,0,18"
                                        Padding="16"
                                        CornerRadius="18"
                                        Background="#F8FCFF"
                                        BorderBrush="#E3F2FF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <CheckBox x:Name="DesktopShortcutBox" Content="创建桌面快捷方式" IsChecked="True" />
                                        <CheckBox x:Name="StartMenuShortcutBox" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="OptionsMessage"
                                           TextWrapping="Wrap"
                                           Foreground="#667085"
                                           FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="InstallPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="InstallTitle"
                                           Text="正在安装 LittleFish"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#101828"
                                           Margin="0,0,0,8" />
                                <TextBlock x:Name="InstallSubtitle"
                                           Text="正在写入文件和创建快捷方式。"
                                           FontSize="14"
                                           Foreground="#667085"
                                           Margin="0,0,0,18" />
                                <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="ProgressText"
                                           Text="准备安装..."
                                           FontSize="13"
                                           Foreground="#667085"
                                           Margin="0,16,0,0" />
                                <Border x:Name="InstallResultCard"
                                        Visibility="Collapsed"
                                        Margin="0,4,0,0"
                                        Padding="18"
                                        CornerRadius="20"
                                        Background="#F8FCFF"
                                        BorderBrush="#D7EEFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="InstallResultText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#344054"
                                                   FontSize="14" />
                                        <CheckBox x:Name="LaunchAfterInstallBox"
                                                  Content="安装完成后启动 LittleFish"
                                                  IsChecked="True"
                                                  Visibility="Collapsed"
                                                  Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="FooterBar" Grid.Row="2" CornerRadius="0,0,28,28" Background="#FFFFFF" BorderBrush="#E3F2FF" BorderThickness="0,1,0,0">
                    <DockPanel Margin="22,0" LastChildFill="False">
                        <TextBlock x:Name="FooterText"
                                   Text="LittleFish v1.6.0"
                                   Foreground="#98A2B3"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton"
                                    Style="{StaticResource FlatButton}"
                                    Content="上一步"
                                    IsEnabled="False"
                                    Click="Back_Click" />
                            <Button x:Name="NextButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="下一步"
                                    Margin="10,0,0,0"
                                    Click="Next_Click" />
                            <Button x:Name="CancelButton"
                                    Style="{StaticResource FlatButton}"
                                    Content="取消"
                                    Margin="10,0,0,0"
                                    Click="Close_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
